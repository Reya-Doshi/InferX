# InferX Environment Configuration Template

# Server Binding
PORT=10000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Gateway Authentication
# Allowed API key for HTTP clients (x-api-key or Bearer token)
INFERX_AUTH_TOKEN=sk-valid-key

# External Cloud LLM Provider (Optional)
# If provided, requests specifying model "gemini-2.5-flash" are dispatched to Google Gemini.
# If omitted or invalid, InferX runs offline using local CPU tensor classification.
GEMINI_API_KEY=your_gemini_api_key_here
